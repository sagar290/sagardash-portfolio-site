---
const {
  className = "",
  icon,
  position = "right",
  href,
  target,
  rel,
  type = "button",
  variant = "primary",
  id,
} = Astro.props;

const isSecondary = variant === "secondary";
const primaryClass =
  "magic-button inline-flex h-12 items-center justify-center rounded-full px-8 text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--brand-color)]";
const secondaryClass = "btn-secondary";
const classes = `${className} ${isSecondary ? secondaryClass : primaryClass}`.trim();
---

{
  href ? (
    <a href={href} target={target} rel={rel} class={classes}>
      <span class="magic-label">
        {position === "left" && icon && <span class="mr-2">{icon}</span>}
        <slot />
        {position === "right" && icon && <span class="ml-2">{icon}</span>}
      </span>
    </a>
  ) : (
    <button id={id} type={type} class={classes}>
      <span class="magic-label">
        {position === "left" && icon && <span class="mr-2">{icon}</span>}
        <slot />
        {position === "right" && icon && <span class="ml-2">{icon}</span>}
      </span>
    </button>
  )
}

<style>
  .magic-button {
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: var(--brand-color);
    border: none;
    box-shadow: 0 6px 18px rgba(var(--brand-rgb), 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .magic-button::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.28) 50%,
      transparent 60%
    );
    transform: translateX(-120%);
    pointer-events: none;
  }

  .magic-button:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    box-shadow: 0 10px 24px rgba(var(--brand-rgb), 0.34);
  }

  .magic-button:hover::before {
    animation: btnShine 0.75s ease;
  }

  @keyframes btnShine {
    to {
      transform: translateX(120%);
    }
  }

  .magic-button:active {
    transform: translateY(0);
  }

  .magic-button:disabled {
    opacity: 0.65;
    pointer-events: none;
    transform: none;
  }

  .magic-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .magic-button:hover {
      transform: none;
    }

    .magic-button:hover::before {
      animation: none;
    }
  }
</style>
