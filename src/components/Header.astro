---
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { href: "/#about", label: "About" },
  { href: "/#experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
  { href: "/#open-source", label: "Open Source" },
  { href: "/#projects", label: "Projects" },
  { href: "/#articles", label: "Articles" },
];
---

<header class="header">
  <div class="header-inner">
    <a href={import.meta.env.BASE_URL} class="logo">
      <div class="logo-avatar">
        <img src="/avatar.png" alt="" width="32" height="32" />
      </div>
      <span class="logo-text">Sagar Dash</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="desktop-links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="desktop-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a href="/#contact" class="contact-btn">Contact</a>
      <button
        id="menu-toggle"
        class="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <nav class="mobile-nav" aria-label="Mobile">
    <ul class="mobile-links">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-link">
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mobile-theme-item">
        <span class="theme-label">Theme Mode</span>
        <ThemeToggle />
      </li>
      <li>
        <a href="/#contact" class="mobile-contact-btn">Contact Me</a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(var(--bg-rgb, 255, 255, 255), 0.7);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-bottom: 1px solid var(--border-color);
  }

  .header-inner {
    height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .logo {
    text-decoration: none;
    color: var(--text-color);
    transition: transform 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .logo-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--brand-color);
    box-shadow: none;
  }

  :global(.dark) .logo-avatar {
    box-shadow: 0 0 10px rgba(var(--brand-rgb), 0.3);
  }

  .logo-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo:hover {
    transform: scale(1.02);
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-color);
  }

  :global(.dark) .logo-text {
    color: var(--brand-color);
  }

  .desktop-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  .desktop-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .desktop-link {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    color: var(--muted-color);
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .desktop-link:hover {
    color: var(--brand-color);
    background: rgba(var(--brand-rgb), 0.08);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .contact-btn {
    background: var(--brand-color);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 99px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(var(--brand-rgb), 0.25);
  }

  .contact-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(var(--brand-rgb), 0.35);
    filter: brightness(1.1);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  @media (min-width: 1100px) {
    .desktop-nav {
      display: flex;
    }
  }

  @media (max-width: 1099px) {
    .menu-toggle {
      display: block;
    }
    .header-actions .contact-btn,
    .header-actions :global(.theme-toggle) {
      display: none;
    }
  }

  .hamburger {
    display: block;
    position: relative;
    width: 24px;
    height: 2px;
    background: var(--text-color);
    transition: all 0.3s ease;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--text-color);
    transition: all 0.3s ease;
  }

  .hamburger::before {
    top: -8px;
  }
  .hamburger::after {
    bottom: -8px;
  }

  .menu-open .hamburger {
    background: transparent;
  }
  .menu-open .hamburger::before {
    transform: rotate(45deg);
    top: 0;
  }
  .menu-open .hamburger::after {
    transform: rotate(-45deg);
    bottom: 0;
  }

  .mobile-menu {
    position: fixed;
    top: 80px;
    left: 0;
    width: 100%;
    height: calc(100vh - 80px);
    background: var(--bg-color);
    z-index: 999;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
  }

  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }

  .mobile-menu.open {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mobile-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-link {
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--text-color);
    transition: color 0.2s ease;
  }

  .mobile-theme-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    margin-top: 1rem;
  }

  .theme-label {
    font-weight: 600;
    opacity: 0.6;
  }

  .mobile-link:hover {
    color: var(--brand-color);
  }

  .mobile-contact-btn {
    margin-top: 2rem;
    background: var(--brand-color);
    color: white !important;
    padding: 1rem;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    font-weight: 700;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-text {
      animation: none;
    }

    .mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const body = document.body;
    const mobileLinks = document.querySelectorAll(
      ".mobile-link, .mobile-contact-btn"
    );

    function setMenuOpen(open: boolean) {
      mobileMenu?.classList.toggle("open", open);
      toggleBtn?.classList.toggle("menu-open", open);
      toggleBtn?.setAttribute("aria-expanded", String(open));
      if (mobileMenu) {
        if (open) {
          mobileMenu.removeAttribute("hidden");
        } else {
          mobileMenu.setAttribute("hidden", "");
        }
      }
      body.style.overflow = open ? "clip" : "";
    }

    function toggleMenu() {
      const isOpen = mobileMenu?.classList.contains("open");
      setMenuOpen(!isOpen);
    }

    toggleBtn?.addEventListener("click", toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (mobileMenu?.classList.contains("open")) {
          setMenuOpen(false);
        }
      });
    });

    window.addEventListener("click", (e) => {
      if (
        mobileMenu?.classList.contains("open") &&
        !mobileMenu.contains(e.target as Node) &&
        !toggleBtn?.contains(e.target as Node)
      ) {
        setMenuOpen(false);
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobileMenu?.classList.contains("open")) {
        setMenuOpen(false);
        toggleBtn?.focus();
      }
    });
  }

  document.addEventListener("astro:page-load", setupHeader);
</script>
