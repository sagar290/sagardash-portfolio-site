---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  PERSON_NAME,
  assetUrl,
  createPersonSchema,
  createProjectSchema,
} from "../../lib/seo";

export async function getStaticPaths() {
  const projectEntries = await getCollection("projects");
  return projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const title = `${entry.data.title} | ${PERSON_NAME}`;
const description = entry.data.description;
const coverImage = entry.data.coverImage
  ? assetUrl(entry.data.coverImage)
  : undefined;

const structuredData = [
  createProjectSchema({
    title: entry.data.title,
    description: entry.data.description,
    slug: entry.slug,
    date: entry.data.date,
    tags: entry.data.tags,
    coverImage: entry.data.coverImage,
  }),
  createPersonSchema(),
];
---

<BaseLayout
  title={title}
  description={description}
  image={coverImage}
  imageWidth={coverImage ? 1280 : undefined}
  imageHeight={coverImage ? 720 : undefined}
  imageAlt={entry.data.title}
  type="article"
  structuredData={structuredData}
>
  <article class="project-layout animate-in">
    <header class="project-header">
      <a href="/#projects" class="back-link">&larr; Back to Projects</a>
      <h1 class="project-title">{entry.data.title}</h1>
      <div class="project-meta">
        <time datetime={entry.data.date.toISOString()}>
          {
            entry.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <div class="project-tags">
          {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
      {
        entry.data.coverImage && (
          <img
            src={entry.data.coverImage}
            alt={`Cover image for ${entry.data.title}`}
            class="cover-image"
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        )
      }
    </header>

    <div class="project-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-layout {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 0 6rem;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--brand-color);
    font-weight: 500;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .project-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    color: var(--text-color);
    opacity: 0.8;
  }
  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .cover-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 3rem;
    filter: saturate(0.82) contrast(0.96) brightness(0.92);
  }

  .project-content {
    font-size: 1.1rem;
    line-height: 1.8;
  }
  :global(.project-content h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  :global(.project-content p) {
    margin-bottom: 1.25rem;
  }
  :global(.project-content ul),
  :global(.project-content ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  :global(.project-content li) {
    margin-bottom: 0.5rem;
  }
  :global(.project-content a) {
    color: var(--brand-color);
    text-decoration: underline;
  }
</style>
