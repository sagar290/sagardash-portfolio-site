---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Content as AboutContent } from "../content/about.md";
import Parser from "rss-parser";
import Sparkles from "../components/ui/Sparkles.astro";
import HeroHighlight from "../components/ui/HeroHighlight.astro";
import MagicButton from "../components/ui/MagicButton.astro";
import { HOME_SEO, createProfilePageSchema } from "../lib/seo";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allExperience = await getCollection("experience");
const sortedExperience = allExperience.sort(
  (a, b) => a.data.order - b.data.order
);
// Render markdown content for experience highlights
const experienceWithContent = await Promise.all(
  sortedExperience.map(async (entry) => {
    const { Content } = await entry.render();
    return { ...entry, Content };
  })
);

const allSkills = await getCollection("skills");
const sortedSkills = allSkills.sort((a, b) => a.data.order - b.data.order);

const allOpenSource = await getCollection("opensource");
const sortedOpenSource = allOpenSource.sort(
  (a, b) => a.data.order - b.data.order
);

// Fetch Articles
const localArticles = await getCollection("articles");
const MEDIUM_RSS_URL = "https://medium.com/feed/@sagar-dash290";
const parser = new Parser();
let mediumArticles: any[] = [];

try {
  const feed = await parser.parseURL(MEDIUM_RSS_URL);
  mediumArticles = feed.items.map((item) => {
    const wordCount = item["content:encoded"]?.split(/\s+/).length || 0;
    const readingTime = Math.ceil(wordCount / 200) || 1;
    return {
      title: item.title,
      link: item.link,
      date: new Date(item.pubDate!),
      readingTime: `${readingTime} min read`,
      source: "Medium",
    };
  });
} catch (error) {
  console.warn("Could not fetch medium articles during build.");
}

const allArticles = [
  ...localArticles.map((a) => ({
    title: a.data.title,
    link: a.data.link || `/articles/${a.slug}`,
    date: a.data.date,
    readingTime: "Local",
    source: "Local",
  })),
  ...mediumArticles,
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const homeStructuredData = createProfilePageSchema(
  HOME_SEO.title,
  HOME_SEO.description
);
---

<BaseLayout
  title={HOME_SEO.title}
  description={HOME_SEO.description}
  keywords={HOME_SEO.keywords}
  structuredData={homeStructuredData}
>
  <!-- Hero Section -->
  <HeroHighlight>
    <div class="container relative z-10 pt-8 md:pt-0">
      <div
        class="section hero animate-in flex flex-col md:flex-row items-center gap-12 lg:gap-20"
      >
        <div class="hero-content flex-1 text-left">
          <h1 class="hero-title leading-tight">
            <span class="highlight">Sagar Dash</span><br />
            Backend Architect
          </h1>
          <p class="hero-tagline max-w-xl">
            8+ years scaling APIs, microservices, and distributed systems in the
            cloud.
          </p>
          <div class="hero-actions mt-8 flex flex-wrap gap-4 relative z-20">
            <MagicButton href="#contact">Get in Touch</MagicButton>
            <MagicButton
              variant="secondary"
              href="https://drive.google.com/file/d/1AMJCy47vP3bqVHn_gX5yRgyi_hZUmI-f/view"
              target="_blank"
              rel="noopener noreferrer">Download CV</MagicButton
            >
          </div>

          <div class="hero-socials mt-8 flex items-center gap-4 relative z-20">
            <a
              href="https://github.com/sagar290"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn github-btn group"
              aria-label="GitHub"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                ></path><path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/sagardash1/"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn linkedin-btn group"
              aria-label="LinkedIn"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path><rect width="4" height="12" x="2" y="9"></rect><circle
                  cx="4"
                  cy="4"
                  r="2"></circle>
              </svg>
            </a>
            <a
              href="https://medium.com/@sagar-dash290"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn medium-btn group"
              aria-label="Medium"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path
                  d="M2.5 3h19c.3 0 .5.2.5.5v17c0 .3-.2.5-.5.5h-19a.5.5 0 0 1-.5-.5v-17c0-.3.2-.5.5-.5z"
                ></path><path
                  d="M12 12m-3.5 0a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0"
                ></path><path
                  d="M18 12c0 1.93-1.12 3.5-2.5 3.5s-2.5-1.57-2.5-3.5 1.12-3.5 2.5-3.5 2.5 1.57 2.5 3.5z"
                ></path><path
                  d="M21 12c0 1.66-.22 3-.5 3s-.5-1.34-.5-3 .22-3 .5-3 .5 1.34.5 3z"
                ></path>
              </svg>
            </a>
            <a
              href="https://x.com/Sagar290"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn x-btn group"
              aria-label="X (Twitter)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M4 4l11.7 16H20L8.3 4H4z"></path><path
                  d="m4 20 6.7-6.8m2.8-2.8L20 4"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="hero-avatar relative">
          <Sparkles particleColor="var(--brand-color)" size={8} />
          <div class="avatar-frame shrink-0">
            <div class="avatar-img-container">
              <img
                src="/avatar.png"
                alt="Sagar Dash"
                class="avatar-img"
                width="300"
                height="300"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </HeroHighlight>

  <!-- About Section -->
  <section id="about" class="section">
    <div class="about-wrapper">
      <h2 class="section-title">About Me</h2>

      <div class="about-highlights">
        <AboutContent />
        <h3 class="highlights-heading">Core Focus</h3>
        <ul class="highlights-list">
          <li class="highlight-item">Microservices Architecture</li>
          <li class="highlight-item">High-Availability Systems</li>
          <li class="highlight-item">Event-Driven Design</li>
          <li class="highlight-item">Cloud Infrastructure</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="section">
    <h2 class="section-title">Experience</h2>
    <div class="experience-list">
      {
        experienceWithContent.map((exp) => (
          <div class="experience-item">
            <div class="experience-header">
              <div>
                <h3 class="experience-role">{exp.data.role}</h3>
                <p class="experience-company">{exp.data.company}</p>
              </div>
              <span class="experience-period">{exp.data.period}</span>
            </div>
            <div class="experience-desc experience-highlights">
              <exp.Content />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="section">
    <h2 class="section-title">Skills</h2>
    <div class="skills-list">
      {
        sortedSkills.map((category) => (
          <div class="skill-row">
            <h3 class="category-title">{category.data.title}</h3>
            <div class="skill-tags">
              {category.data.skills.map((skill) => (
                <span class="tag">{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Open Source Section -->
  <section id="open-source" class="section">
    <h2 class="section-title">Open Source</h2>
    <div class="os-grid">
      {
        sortedOpenSource.map((project) => (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="os-card"
          >
            <div class="os-header">
              <h3 class="os-title">{project.data.title}</h3>
              <span class={`os-role ${project.data.role.toLowerCase()}`}>
                {project.data.role}
              </span>
            </div>
            <p class="os-desc">{project.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="section">
    <h2 class="section-title">Featured Projects</h2>
    <div class="projects-grid">
      {
        sortedProjects.length > 0 ? (
          sortedProjects.map((project) => (
            <a href={`/projects/${project.slug}`} class="project-card">
              {project.data.coverImage ? (
                <img
                  src={project.data.coverImage}
                  alt={project.data.title}
                  class="project-image"
                  width="600"
                  height="338"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="project-image-placeholder" aria-hidden="true" />
              )}
              <div class="project-info">
                <h3 class="project-title">{project.data.title}</h3>
                <p class="project-desc">{project.data.description}</p>
                <div class="project-tags">
                  {project.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))
        ) : (
          <p>No projects found. Check back soon!</p>
        )
      }
    </div>
  </section>

  <!-- Articles Section -->
  <section id="articles" class="section">
    <h2 class="section-title">Latest Articles</h2>
    <p class="section-subtitle">Thoughts, opinions, and technical tutorials.</p>

    <div class="carousel-container">
      <div class="carousel-track" id="articles-carousel">
        {
          allArticles.map((article) => (
            <div class="carousel-item">
              <a
                href={article.link}
                target="_blank"
                rel="noopener noreferrer"
                class="article-card-mini"
              >
                <div class="article-meta-mini">
                  <span class="source-tag-mini">{article.source}</span>
                  <span class="read-time-mini">{article.readingTime}</span>
                </div>
                <h3 class="article-title-mini">{article.title}</h3>
                <time class="article-date-mini">
                  {article.date.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                </time>
              </a>
            </div>
          ))
        }
      </div>

      <div class="carousel-controls">
        <button class="carousel-btn prev" aria-label="Previous articles"
          >&larr;</button
        >
        <button class="carousel-btn next" aria-label="Next articles"
          >&rarr;</button
        >
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section contact">
    <h2 class="section-title">Get in Touch</h2>
    <p class="contact-intro">
      Prefer email? Write to
      <a href="mailto:talk@sagardash.me">talk@sagardash.me</a>
      — or send a message below.
    </p>

    <form
      id="contact-form"
      class="contact-form"
      action="https://formspree.io/f/xreawpqj"
      method="POST"
      novalidate
    >
      <div class="form-group">
        <label for="name">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          placeholder="Your Name"
        />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="your.email@example.com"
        />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          placeholder="What's on your mind?"></textarea>
      </div>
      <MagicButton type="submit" id="contact-submit">Send Message</MagicButton>
      <div
        id="form-status"
        class="form-status"
        role="status"
        aria-live="polite"
      ></div>
    </form>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: flex;
    align-items: center;
    gap: 3rem;
    min-height: 80vh;
  }
  .hero-content {
    flex: 1;
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-color);
  }
  .highlight {
    color: var(--brand-color);
  }
  .hero-tagline {
    font-size: 1.25rem;
    color: var(--muted-color);
    margin: 1.5rem 0 0 0;
    max-width: 600px;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
  }
  .hero-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: #fff;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease,
      transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 1px 2px rgba(10, 22, 40, 0.04);
  }
  .social-icon-btn:hover {
    color: var(--brand-color);
    border-color: rgba(var(--brand-rgb), 0.45);
    background: rgba(var(--brand-rgb), 0.06);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  :global(.dark) .social-icon-btn {
    background: rgba(255, 255, 255, 0.04);
    box-shadow: none;
  }
  .social-icon-btn svg {
    width: 20px;
    height: 20px;
  }
  .hero-avatar {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .avatar-frame {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    padding: 4px;
    background: var(--brand-color);
    box-shadow: 0 12px 28px rgba(10, 22, 40, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  :global(.dark) .avatar-frame {
    box-shadow: 0 14px 32px rgba(var(--brand-rgb), 0.2);
  }
  .avatar-frame:hover {
    transform: scale(1.02) translateY(-5px);
  }
  .avatar-img-container {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden; /* Ensures the image is strictly circular */
    border: 4px solid var(--bg-color);
    background: var(--bg-color);
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes gradientMove {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Section Titles */
  .section-title {
    font-size: 2rem;
    margin-bottom: 2rem;
    position: relative;
    display: inline-block;
  }
  .section-title::after {
    content: "";
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 60%;
    height: 4px;
    background: var(--brand-color);
    border-radius: 2px;
  }

  /* About */
  .about-wrapper {
    position: relative;
  }

  .about-highlights {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 42rem;
  }

  .highlights-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.75rem 0 0.75rem;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.5rem 1.5rem;
  }

  .highlight-item {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    color: var(--text-color);
    opacity: 0.9;
  }

  .highlight-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-color);
  }

  :global(.about-highlights p) {
    margin-bottom: 0.75rem;
  }

  /* Experience Timeline */
  .experience-list {
    position: relative;
    padding-left: 2rem;
  }
  .experience-list::before {
    content: "";
    position: absolute;
    top: 0;
    left: 8px; /* Centers the 2px line based on the dot size */
    bottom: 0;
    width: 2px;
    background: var(--border-color);
  }

  .experience-item {
    position: relative;
    padding-bottom: 3rem;
  }
  .experience-item:last-child {
    padding-bottom: 0;
  }
  .experience-item::before {
    content: "";
    position: absolute;
    left: -2rem; /* Exact offset needed relative to padding-left */
    top: 0.25rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-color);
    border: 3px solid var(--brand-color);
    z-index: 10;
    box-shadow: 0 0 0 4px var(--bg-color); /* Cut out background effectively */
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .experience-role {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }
  .experience-company {
    font-size: 1rem;
    color: var(--text-color);
    opacity: 0.9;
    font-weight: 500;
  }
  .experience-period {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--brand-color);
    opacity: 0.9;
  }
  .experience-desc {
    margin: 1rem 0 0 0;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
  }
  .experience-highlights {
    padding-left: 0;
    font-size: 0.95rem;
    opacity: 0.8;
    list-style-type: none; /* Custom bullets */
  }
  :global(.experience-highlights p) {
    margin-bottom: 0.5rem;
  }
  :global(.experience-highlights ul) {
    list-style: none;
    padding-left: 1.25rem;
  }
  :global(.experience-highlights li) {
    margin-bottom: 0.5rem;
    position: relative;
  }
  :global(.experience-highlights li::before) {
    content: "→";
    position: absolute;
    left: -1.25rem;
    color: var(--brand-color);
    opacity: 0.7;
  }

  /* Skills */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-top: 1px solid var(--border-color);
  }
  .skill-row {
    display: grid;
    grid-template-columns: minmax(120px, 180px) 1fr;
    gap: 1rem 2rem;
    align-items: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  .category-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-color);
  }
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-tags .tag {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  /* Open Source Grid */
  .os-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .os-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    color: inherit;
  }
  .os-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--brand-color);
  }
  .os-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    gap: 1rem;
  }
  .os-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.4;
  }
  .os-role {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    white-space: nowrap;
  }
  .os-role.author {
    background-color: rgba(var(--brand-rgb), 0.1);
    color: var(--brand-color);
    border: 1px solid rgba(var(--brand-rgb), 0.2);
  }
  .os-role.contributor {
